# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
frontend/dist/
frontend/.vite/

# Build artifacts
backend/app/static/

# Env / secrets
.env
*.env
!*.example.env

# Editors / OS
.vscode/
.idea/
.DS_Store

# Claude Code — share .claude/skills/, keep per-machine settings + worktrees local
.claude/settings.local.json
.claude/worktrees/

# Playwright
ms-playwright/
test-results/
playwright-report/

# Graph mocks — keep anonymized fixtures, never commit real (token-bearing) ones
backend/data/mocks/*.graph.json
!backend/data/mocks/*.graph.anon.json
# Media migration audit maps (issue #47) — derivable from trip.json git history
backend/data/mocks/*.media-map.json

# Trip media lives in Garage (issue #47) — the local assets dir is a working
# scratch space for the migrate_assets_to_s3.py pipeline, never committed.
backend/data/assets/

# Vendored agent skills (`npx skills add maplibre/maplibre-agent-skills`, #18).
# skills-lock.json pins them, so the content is restorable and not worth
# carrying in the repo; the kiseki-* skills under .claude/skills ARE ours.
.agents/
.claude/skills/maplibre-*
